{
  "name": "flux-desktop",
  "version": "2.6.6",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run build:extensions && npm run check:i18n && npm run test:extension && npm run test:ui && npm run build",
    "test:extension": "node --test extension/tests/*.test.js",
    "tauri": "tauri",
    "format": "prettier --write src scripts/*.mjs vite.config.ts",
    "test:ui": "node --test tests/*.test.mjs",
    "build:extensions": "node scripts/build-extensions.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-virtual": "^3.14.14",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "i18next": "^25.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
