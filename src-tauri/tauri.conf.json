{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux",
  "version": "2.7.0",
  "identifier": "io.flux.download",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flux",
        "width": 1180,
        "height": 780,
        "minWidth": 640,
        "minHeight": 420,
        "visible": false,
        "transparent": true,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCQzlGNjZCNTJBNjQ3OUYKUldTZlI2WlNhL2JKRzNOOGV6N1VFMitZVGFPR0dDY2E4L1pPQ3ovVmxDMWZHc09kajM2dlJENk0K",
      "windows": {
        "installMode": "quiet"
      },
      "endpoints": [
        "https://github.com/Hactor00/Flux/releases/latest/download/latest.json"
      ]
    }
  }
}
