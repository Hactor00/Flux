{
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Persistent parallel downloads and adaptive media capture",
    "resources": {
      "../.tools/package/FluxTorrentBridge.dll": "FluxTorrentBridge.dll",
      "../.tools/package/libtorrent-rasterbar.dll": "libtorrent-rasterbar.dll",
      "../.tools/package/libssl-3-x64.dll": "libssl-3-x64.dll",
      "../.tools/package/libcrypto-3-x64.dll": "libcrypto-3-x64.dll",
      "../.tools/package/libstdc++-6.dll": "libstdc++-6.dll",
      "../.tools/package/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "../.tools/package/libwinpthread-1.dll": "libwinpthread-1.dll",
      "../.tools/package/native-licenses/": "native-licenses/",
      "../.tools/package/flux-cli.exe": "flux-cli.exe",
      "../.tools/package/flux-native-host.exe": "flux-native-host.exe",
      "../.tools/package/ffmpeg.exe": "ffmpeg.exe",
      "../.tools/package/ffprobe.exe": "ffprobe.exe",
      "../.tools/package/yt-dlp.exe": "yt-dlp.exe",
      "../.tools/package/node.exe": "node.exe",
      "../target/release/libunwind.dll": "libunwind.dll",
      "../.tools/package/extension/": "extension/",
      "../.tools/package/extension-firefox/": "extension-firefox/",
      "../.tools/package/extension-firefox-modern/": "extension-firefox-modern/",
      "../.tools/package/licenses/": "licenses/",
      "../.tools/package/media-source/": "media-source/",
      "../.tools/package/LICENSE": "LICENSE",
      "../.tools/package/THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../.tools/package/dependency-inventory.json": "dependency-inventory.json",
      "../target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true,
        "sidebarImage": "installer-assets/sidebar.bmp",
        "headerImage": "installer-assets/header.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
